<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude all private user data and chat history from leaving the device to remote cloud backups -->
        <exclude domain="database" path="." />
        <exclude domain="file" path="mobharn_vault" />
        <exclude domain="file" path="workspace" />
        <!-- Exclude large replaceable LiteRT model weights -->
        <exclude domain="sharedpref" path="approval_rules.xml" />
        <exclude domain="file" path="litertlm_models" />
    </cloud-backup>
    <device-transfer>
        <!-- Direct phone-to-phone migration preserves user databases, vault notes, and workspaces,
             but excludes large replaceable model weights to conserve bandwidth and storage -->
        <exclude domain="sharedpref" path="approval_rules.xml" />
        <exclude domain="file" path="litertlm_models" />
    </device-transfer>
</data-extraction-rules>
